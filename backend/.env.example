# Giá trị DEV công khai — không dùng cho môi trường nào khác (ARCHITECTURE §A10.2).
# Sao chép thành backend/.env (đã gitignore).
NODE_ENV=development
PORT=3000
# Tuỳ chọn bind loopback khi host qua reverse proxy/tunnel; launcher luôn dùng 127.0.0.1.
# HOST=127.0.0.1
# Launcher local: BTL_LOCAL_PRODUCTION=1 để chạy backend/dist + frontend/dist đã build.
DATABASE_URL=mysql://btl:btl_dev_password@localhost:3306/btl_cloud

# Object storage S3-compatible (local: SeaweedFS trong docker-compose, cổng 9000).
# Trên AWS: để trống S3_ENDPOINT, S3_FORCE_PATH_STYLE=false và KHÔNG đặt access key (dùng IAM Role).
S3_BUCKET=btl-cloud-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-dev

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
SESSION_COOKIE_NAME=sid
COOKIE_SECURE=false
HSTS_ENABLED=false
SESSION_TTL_HOURS=168
TRUST_PROXY=false

UPLOAD_TMP_DIR=./tmp/uploads
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=debug
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=../frontend/dist
# INSTANCE_ID=   (trống → hostname)

# Số ngày giữ sự kiện audit (E7, 1–3650); quá hạn bị xoá khi backend khởi động.
AUDIT_RETENTION_DAYS=90
