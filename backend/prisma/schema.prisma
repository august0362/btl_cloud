// Schema theo ARCHITECTURE §A4.3. Tên bảng/cột snake_case qua @@map/@map.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum FileType {
  PDF
  DOCX
  PPTX
}

model User {
  id                String     @id @db.Char(36)
  email             String     @unique(map: "uq_users_email") @db.VarChar(254)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  displayName       String     @map("display_name") @db.VarChar(100)
  createdAt         DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  // E1 (§A12.4): chỉ ghi bằng SQL thô (UserRepository.touchLastActive) để không đổi updated_at.
  lastActiveAt      DateTime?  @map("last_active_at") @db.DateTime(3)
  // E2 (§A12.4, XBR-06): khác NULL = DELETING; app public coi như user không tồn tại.
  deletionStartedAt DateTime?  @map("deletion_started_at") @db.DateTime(3)
  sessions          Session[]
  documents         Document[]

  @@index([lastActiveAt], map: "idx_users_last_active_at")
  @@map("users")
}

model Session {
  id        String   @id @db.Char(64)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model Document {
  id               String     @id @db.Char(36)
  ownerId          String     @map("owner_id") @db.Char(36)
  title            String     @db.VarChar(200)
  description      String?    @db.VarChar(2000)
  visibility       Visibility
  fileType         FileType   @map("file_type")
  mimeType         String     @map("mime_type") @db.VarChar(100)
  originalFilename String     @map("original_filename") @db.VarChar(255)
  sizeBytes        Int        @map("size_bytes") @db.UnsignedInt
  storageKey       String     @unique(map: "uq_documents_storage_key") @map("storage_key") @db.VarChar(512)
  fileVersion      Int        @default(1) @map("file_version") @db.UnsignedInt
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  fileUpdatedAt    DateTime   @map("file_updated_at") @db.DateTime(3)
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([visibility, createdAt], map: "idx_documents_visibility_created")
  @@index([ownerId, createdAt], map: "idx_documents_owner_created")
  @@map("documents")
}

enum AuditActorType {
  USER
  DEVELOPER
  ANONYMOUS
}

enum AuditTargetType {
  USER
  DOCUMENT
  FRIENDSHIP
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

// E7 (§A12.4, XM-13): bảng chỉ thêm dòng. Không FK để sự kiện còn sau khi đối tượng bị xoá.
model AuditEvent {
  id         BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  createdAt  DateTime         @map("created_at") @db.DateTime(3)
  actorType  AuditActorType   @map("actor_type")
  actorId    String?          @map("actor_id") @db.VarChar(64)
  action     String           @db.VarChar(40)
  targetType AuditTargetType? @map("target_type")
  targetId   String?          @map("target_id") @db.Char(36)
  outcome    AuditOutcome
  errorCode  String?          @map("error_code") @db.VarChar(40)
  requestId  String?          @map("request_id") @db.Char(36)
  metadata   Json?

  @@index([createdAt], map: "idx_audit_events_created_at")
  @@index([actorId, createdAt], map: "idx_audit_events_actor_created")
  @@index([targetId, createdAt], map: "idx_audit_events_target_created")
  @@index([requestId], map: "idx_audit_events_request_id")
  @@map("audit_events")
}
