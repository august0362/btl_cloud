// Schema theo ARCHITECTURE §A4.3. Tên bảng/cột snake_case qua @@map/@map.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum FileType {
  PDF
  DOCX
  PPTX
}

model User {
  id                     String                @id @db.Char(36)
  email                  String                @unique(map: "uq_users_email") @db.VarChar(254)
  passwordHash           String                @map("password_hash") @db.VarChar(255)
  displayName            String                @map("display_name") @db.VarChar(100)
  createdAt              DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  // E1 (§A12.4): chỉ ghi bằng SQL thô (UserRepository.touchLastActive) để không đổi updated_at.
  lastActiveAt           DateTime?             @map("last_active_at") @db.DateTime(3)
  // E2 (§A12.4, XBR-06): khác NULL = DELETING; app public coi như user không tồn tại.
  deletionStartedAt      DateTime?             @map("deletion_started_at") @db.DateTime(3)
  personalizationEnabled Boolean               @default(false) @map("personalization_enabled")
  interactions           DocumentInteraction[]
  sessions               Session[]
  documents              Document[]

  @@index([lastActiveAt], map: "idx_users_last_active_at")
  @@map("users")
}

model Session {
  id        String   @id @db.Char(64)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model Document {
  id               String                @id @db.Char(36)
  ownerId          String                @map("owner_id") @db.Char(36)
  title            String                @db.VarChar(200)
  description      String?               @db.VarChar(2000)
  visibility       Visibility
  fileType         FileType              @map("file_type")
  mimeType         String                @map("mime_type") @db.VarChar(100)
  originalFilename String                @map("original_filename") @db.VarChar(255)
  sizeBytes        Int                   @map("size_bytes") @db.UnsignedInt
  storageKey       String                @unique(map: "uq_documents_storage_key") @map("storage_key") @db.VarChar(512)
  fileVersion      Int                   @default(1) @map("file_version") @db.UnsignedInt
  createdAt        DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  fileUpdatedAt    DateTime              @map("file_updated_at") @db.DateTime(3)
  fingerprint      DocumentFingerprint?
  interactions     DocumentInteraction[]
  owner            User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([visibility, createdAt], map: "idx_documents_visibility_created")
  @@index([ownerId, createdAt], map: "idx_documents_owner_created")
  @@map("documents")
}

enum AuditActorType {
  USER
  DEVELOPER
  ANONYMOUS
}

enum AuditTargetType {
  USER
  DOCUMENT
  FRIENDSHIP
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

// E7 (§A12.4, XM-13): bảng chỉ thêm dòng. Không FK để sự kiện còn sau khi đối tượng bị xoá.
model AuditEvent {
  id         BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  createdAt  DateTime         @map("created_at") @db.DateTime(3)
  actorType  AuditActorType   @map("actor_type")
  actorId    String?          @map("actor_id") @db.VarChar(64)
  action     String           @db.VarChar(40)
  targetType AuditTargetType? @map("target_type")
  targetId   String?          @map("target_id") @db.Char(36)
  outcome    AuditOutcome
  errorCode  String?          @map("error_code") @db.VarChar(40)
  requestId  String?          @map("request_id") @db.Char(36)
  metadata   Json?

  @@index([createdAt], map: "idx_audit_events_created_at")
  @@index([actorId, createdAt], map: "idx_audit_events_actor_created")
  @@index([targetId, createdAt], map: "idx_audit_events_target_created")
  @@index([requestId], map: "idx_audit_events_request_id")
  @@map("audit_events")
}

enum FingerprintTextStatus {
  OK // đã phân tích toàn bộ phần chữ trong giới hạn
  PARTIAL // dừng vì chạm giới hạn (số từ/trang/phần XML), vẫn có chữ ký
  SKIPPED // không có chữ ký; lý do ở text_reason
}

enum InteractionKind {
  VIEW
  DOWNLOAD
}

// Feature A. 1 dòng / tài liệu, mô tả đúng phiên bản tệp hiện tại (file_version).
model DocumentFingerprint {
  documentId   String                @id @map("document_id") @db.Char(36)
  fileVersion  Int                   @map("file_version") @db.UnsignedInt
  sha256       String                @db.Char(64)
  algoVersion  Int                   @map("algo_version") @db.UnsignedSmallInt
  textStatus   FingerprintTextStatus @map("text_status")
  textReason   String?               @map("text_reason") @db.VarChar(30)
  textSha256   String?               @map("text_sha256") @db.Char(64) // chỉ khi text_status = OK
  shingleCount Int?                  @map("shingle_count") @db.UnsignedInt
  minhash      Bytes?                @db.VarBinary(512) // 128 × uint32 big-endian
  createdAt    DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  document     Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([sha256], map: "idx_document_fingerprints_sha256")
  @@index([textSha256], map: "idx_document_fingerprints_text_sha256")
  @@index([algoVersion, shingleCount], map: "idx_document_fingerprints_algo_shingles")
  @@map("document_fingerprints")
}

// Feature B. 1 dòng / (user, tài liệu, loại); lặp lại chỉ cập nhật last_at.
model DocumentInteraction {
  userId     String          @map("user_id") @db.Char(36)
  documentId String          @map("document_id") @db.Char(36)
  kind       InteractionKind
  firstAt    DateTime        @map("first_at") @db.DateTime(3)
  lastAt     DateTime        @map("last_at") @db.DateTime(3)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([userId, documentId, kind])
  @@index([documentId, lastAt], map: "idx_document_interactions_document_last")
  @@index([lastAt], map: "idx_document_interactions_last_at")
  @@map("document_interactions")
}
